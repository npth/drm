<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory="var/phpunit.cache"
         executionOrder="depends,defects"
         requireCoverageMetadata="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnPhpunitDeprecations="true"
         failOnPhpunitDeprecation="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="default">
            <directory>tests</directory>
            <directory>src/Access/Test</directory>
            <directory>src/Auth/Test</directory>
            <directory>src/Crm/Client/Test</directory>
            <directory>src/Crm/Contract/Test</directory>
            <directory>src/FlexConditions/Test</directory>
            <directory>src/Http/Test</directory>
            <directory>src/OAuth/Test</directory>
        </testsuite>
    </testsuites>

    <source ignoreIndirectDeprecations="true" restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>src</directory>
        </include>
        <exclude>
            <directory>src/Access/Test</directory>
            <directory>src/Auth/Test</directory>
            <directory>src/Crm/Client/Test</directory>
            <directory>src/Crm/Contract/Test</directory>
            <directory>src/FlexConditions/Test</directory>
            <directory>src/Http/Test</directory>
            <directory>src/OAuth/Test</directory>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="test" force="true"/>
        <env name="APP_DEBUG" value="1" force="true"/>

        <ini name="error_reporting" value="32767"/>
        <ini name="display_errors" value="On"/>
    </php>
</phpunit>
