{
  "name": "delorealty/management",
  "description": "Delo Realty Management",
  "type": "project",
  "license": "BSD-3-Clause",
  "config": {
    "process-timeout": 0,
    "sort-packages": true
  },
  "require": {
    "php": "^8.5",
    "ext-bcmath": "*",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "eftec/bladeone": "^4.19",
    "foroco/php-browser-detection": "^2.8",
    "illuminate/console": "^12.52",
    "illuminate/database": "^12.52",
    "illuminate/filesystem": "^12.52",
    "laminas/laminas-config-aggregator": "^1.18",
    "league/oauth2-server": "^9.2",
    "monolog/monolog": "^3.9",
    "php-di/php-di": "^7.0",
    "predis/predis": "^3.4",
    "slim/psr7": "^1.7",
    "slim/slim": "4.*",
    "symfony/console": "^7.2",
    "webmozart/assert": "^2.1",
    "yuwuhsien/laravel-bcmath-cast": "^1.2"
  },
  "require-dev": {
    "dg/bypass-finals": "^1.9",
    "overtrue/phplint": "^9.5",
    "phpunit/phpunit": "^12.0",
    "roave/security-advisories": "dev-latest",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "replace": {
    "symfony/polyfill-mbstring": "*",
    "symfony/polyfill-php70": "*",
    "symfony/polyfill-php71": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*",
    "symfony/polyfill-php83": "*",
    "symfony/polyfill-php84": "*"
  },
  "autoload": {
    "files": [
      "src/env.php"
    ],
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "app": "php bin/app.php --ansi",
    "phpcs": "phpcs --standard=phpcs.xml",
    "phpcbf": "phpcbf",
    "lint": "phplint",
    "test": "phpunit --colors=always",
    "test-coverage": " XDEBUG_MODE=coverage phpunit --colors=always --coverage-html var/coverage"
  }
}
